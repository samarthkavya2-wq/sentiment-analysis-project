# ============================================
# SentixAI Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to public Git repositories!
# ============================================

# Secret key used by Flask for secure session management
SECRET_KEY=change-this-to-a-random-secure-string-in-production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sentiment_analysis

# Optional: Full Database URL (if provided by cloud provider like Render or Railway)
# DATABASE_URL=mysql://username:password@hostname:3306/sentiment_analysis

# Optional: SSL configuration (set to REQUIRED for cloud providers like Aiven/TiDB)
# DB_SSL_MODE=REQUIRED

# Server Configuration
PORT=5000
FLASK_DEBUG=0
